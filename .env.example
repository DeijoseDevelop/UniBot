TELEGRAM_TOKEN=your_telegram_bot_token
DEEPSEEK_API_KEY=your_deepseek_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback
NOTION_TOKEN=your_notion_integration_token
NOTION_DB_ID=your_notion_database_id
NOTION_ANCHOR_PAGE_ID=your_anchor_page_id
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_service_key
SUPABASE_DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres
# Vacío (o ausente) = modo polling local; con valor = modo webhook (Railway)
WEBHOOK_URL=
PORT=8080

# Opcionales
# OPENAI_API_KEY: si se define, las notas de voz se transcriben con Whisper
OPENAI_API_KEY=
# IDs de carpetas de Google Drive para upload_image (vacío = subir a root)
FOLDER_APUNTES_ID=
FOLDER_TAREAS_ID=
FOLDER_DOCUMENTOS_ID=
# Límite de mensajes por usuario por minuto (0 = sin límite)
RATE_LIMIT_MAX_PER_MIN=30
# Recordatorios automáticos de tareas/eventos próximos
REMINDER_ENABLED=true
REMINDER_HOURS_AHEAD=24
